APP_NAME=AI Seller Core
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://ai_seller:CHANGE_ME@127.0.0.1:5432/ai_seller
QDRANT_URL=http://127.0.0.1:6333
# Required for staging and production. Keep the actual key out of the repository.
# SECRET_ENCRYPTION_KEY=
# Set only when Qdrant authentication is enabled.
# QDRANT_API_KEY=
JOB_POLL_INTERVAL_SECONDS=1
JOB_LEASE_SECONDS=60
